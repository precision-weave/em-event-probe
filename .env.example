# Copy to .env to override config.local.json. Command-line arguments override these in turn:
#   just start [board-id] [port]   or   node app.mjs [board-id] [port]
# Leave a line commented out to use the value from config.local.json or the default.

# EP_BOARD_ID=
# EP_PORT=8790
# EP_TOKEN=
# EP_ORG_ID=
# EP_BASE_URL=https://api.eventmodelers.ai
